{
  "expo": {
    "name": "Camina y Alimenta",
    "slug": "camina-y-alimenta",
    "scheme": "caminayalimenta",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1F7A4D",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "Contamos tus pasos para activar donaciones de comidas."
      }
    },
    "android": {
      "permissions": ["ACTIVITY_RECOGNITION"]
    },
    "plugins": ["expo-notifications"]
  }
}
