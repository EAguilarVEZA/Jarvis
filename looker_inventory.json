    "coming_soon_state": "Empty KPI shows 'Coming Soon...' text + note explaining pending data source",
    "fonts": "Sans-serif (mix of clean modern + display weight for KPI numbers)",
    "delta_arrow_colors": "Up = green (#2a7), Down = red/orange (#e44/#f00)"
